[Unit]
Description=Walnuts Roastery operations
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=walnuts
Group=walnuts
WorkingDirectory=/opt/walnuts-roastery
EnvironmentFile=/etc/walnuts.env
ExecStart=/usr/bin/python3 -m server.app --host 127.0.0.1 --port 8765 --db /var/lib/walnuts/production.sqlite
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/walnuts

[Install]
WantedBy=multi-user.target
